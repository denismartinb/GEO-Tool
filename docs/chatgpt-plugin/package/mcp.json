{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "genscore": {
      "type": "streamable-http",
      "url": "https://www.genscore.es/api/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "dcr", "tokenEndpointAuthMethod": "none" },
            "baseScopes": ["openid", "email"]
          }
        }
      }
    }
  }
}
