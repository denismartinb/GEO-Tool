{
  "manifest_version": 3,
  "name": "GenScore (prueba)",
  "short_name": "GenScore",
  "version": "0.5.1",
  "description": "Versión de prueba. Revisa la página abierta para SEO e IA al pulsar el icono. La parte de cuenta usa datos de ejemplo.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Revisar esta página con GenScore",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Revisar esta página"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
