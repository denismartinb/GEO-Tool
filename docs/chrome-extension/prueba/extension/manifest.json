{
  "manifest_version": 3,
  "name": "Auditoría SEO y GEO: visibilidad en IA · GenScore",
  "short_name": "GenScore",
  "version": "1.4.1",
  "description": "Auditoría SEO y GEO gratis: mira si ChatGPT, Gemini, Claude y Perplexity pueden leer tu web, con llms.txt, robots.txt y schema.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Revisar esta página con GenScore",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Revisar esta página"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "https://www.genscore.es/*"
  ]
}
