{
  "name": "geo-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pilot": "node scripts/pilot.mjs",
    "pilot:selfcheck": "node scripts/pilot-selfcheck.mjs",
    "bench:extraction": "NODE_OPTIONS=--conditions=react-server tsx scripts/extraction-bench.ts",
    "validate": "pnpm run build && pnpm run typecheck && pnpm run lint",
    "check:env": "node --experimental-strip-types scripts/check-env.mjs",
    "fix:log-numbering": "node --experimental-strip-types scripts/fix-log-numbering.mjs",
    "supabase:bundle": "node scripts/bundle-supabase-migrations.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.10",
    "@sentry/nextjs": "^10.64.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.8",
    "clsx": "^2.1.1",
    "next": "16.2.6",
    "posthog-js": "^1.399.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "stripe": "^22.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.17.46",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.3",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
