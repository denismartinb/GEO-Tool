NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this in client code and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Server-only. Used by future OpenAI provider. Never expose in client code.
OPENAI_API_KEY=

# Optional future OpenAI provider model. Not used by the current Gemini-only MVP.
OPENAI_MODEL=

# Anthropic / Claude provider. Server-only. Never expose in client code.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=

# LLM engines to run per scan, comma-separated. Set this to run multiple
# engines simultaneously, e.g. "gemini,claude" — each active prompt gets one
# scan_prompt_results row per listed engine, and KPIs/cards are computed from
# the combined sample of all engines' rows.
# Valid values: any comma-separated combination of gemini | claude
LLM_SCAN_PROVIDERS=

# Legacy single-engine var, kept for back-compat. Only used when
# LLM_SCAN_PROVIDERS is unset. Defaults to "gemini" if both are unset.
# Valid values: gemini | claude
LLM_SCAN_PROVIDER=

# Required for the weekly scan cron route (app/api/cron/weekly-scans). Vercel
# sends this as `Authorization: Bearer <CRON_SECRET>`. Server-only.
CRON_SECRET=

# Kill switch for automated recurring scans. Defaults to disabled (any value
# other than "true" disables the cron route's scan logic).
CRON_SCANS_ENABLED=

# Optional. Caps how many projects the weekly cron processes per run. Defaults to 5.
MAX_PROJECTS_PER_CRON_RUN=

# --- Agentic user pilot (UX-PILOT-1) ---
# Credentials for the dedicated pilot account the `ux-pilot` agent drives
# against a Vercel preview. NEVER the founder's own account, never committed,
# never passed on a command line. See docs/agentic-user-pilot.md.
# Local runs read these from .env.local; agent sessions read them from the
# environment. The pilot is read-only: it never launches scans and never
# creates or deletes projects.
PILOT_EMAIL=
PILOT_PASSWORD=

# Optional. Pins which project the pilot journeys inspect. When unset, the
# pilot discovers the first project on the account.
PILOT_PROJECT_ID=

# Optional. Overrides the Chromium binary Playwright launches. Only needed when
# neither PLAYWRIGHT_BROWSERS_PATH nor Playwright's own download applies.
PILOT_CHROMIUM_PATH=
