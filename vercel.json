{
  "regions": ["dub1"],
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "crons": [
    {
      "path": "/api/cron/weekly-scans",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/run-audit",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/scan-watchdog",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "45 7 * * *"
    }
  ]
}
